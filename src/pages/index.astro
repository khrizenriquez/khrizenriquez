---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { es } from "@/i18n/es";
import { withBasePath } from "@/utils/base";
import { profileLinks } from "@/utils/links";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.language === "es")
  .sort((a, b) => a.data.order - b.data.order);

const homeHref = withBasePath("");
const projectCountLabel = projects.length === 1 ? es.projects.countSingular : es.projects.countPlural;
---

<BaseLayout>
  <main class="portfolio-shell">
    <header class="hero portfolio-hero">
      <nav class="portfolio-nav" aria-label="Principal" data-portfolio-nav>
        <a class="portfolio-mark" href={homeHref} data-portfolio-mark aria-label="Inicio">
          {es.hero.name}
        </a>
        <div class="nav-search" role="search">
          <label class="sr-only" for="project-search">{es.projects.searchLabel}</label>
          <input
            class="input nav-search__input"
            id="project-search"
            type="search"
            placeholder={es.projects.searchPlaceholder}
            autocomplete="off"
            data-project-search
          />
          <button class="button nav-search__clear" type="button" data-project-search-clear hidden>
            {es.projects.clearSearch}
          </button>
        </div>
        <div class="portfolio-nav__actions">
          <a href="#projects">{es.nav.projects}</a>
          <a href={`mailto:${profileLinks.email.replace("mailto:", "")}`}>{es.nav.contact}</a>
          <ThemeToggle />
        </div>
      </nav>

      <section class="hero-body portfolio-hero__body">
        <div class="container hero-content" data-hero-content>
          <p class="eyebrow">{es.hero.eyebrow}</p>
          <h1>{es.hero.name}</h1>
          <p class="role">{es.hero.role}</p>
          <p class="hero-summary">{es.hero.summary}</p>
          <div class="hero-links">
            <a class="button is-dark is-rounded" href={profileLinks.linkedin} target="_blank" rel="noreferrer">
              {es.links.linkedin}
            </a>
            <a class="button is-light is-rounded" href={profileLinks.github} target="_blank" rel="noreferrer">
              {es.links.github}
            </a>
            <a class="button is-text" href={profileLinks.email}>
              {es.links.email}
            </a>
            <a class="button scroll-action" href="#projects">
              {es.projects.scrollCta}
            </a>
          </div>
        </div>
      </section>
    </header>

    <section class="section project-section" id="projects">
      <div class="projects-frame">
        <div class="section-heading">
          <p class="eyebrow">{es.projects.heading}</p>
          <p class="project-count" data-project-search-count>{projects.length} {projectCountLabel}</p>
        </div>
        <div class="project-grid">
          {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
        </div>
        <div class="project-empty" data-project-empty hidden>
          <h3>{es.projects.emptyTitle}</h3>
          <p>{es.projects.emptyBody}</p>
        </div>
      </div>
    </section>

    <footer class="portfolio-footer">
      <p>{es.footer.note}</p>
      <div>
        <a href={profileLinks.github} target="_blank" rel="noreferrer">{es.links.github}</a>
        <a href={profileLinks.linkedin} target="_blank" rel="noreferrer">{es.links.linkedin}</a>
      </div>
    </footer>
  </main>
</BaseLayout>

<script>
  const searchInput = document.querySelector("[data-project-search]");
  const clearButton = document.querySelector("[data-project-search-clear]");
  const countElement = document.querySelector("[data-project-search-count]");
  const emptyState = document.querySelector("[data-project-empty]");
  const nav = document.querySelector("[data-portfolio-nav]");
  const heroContent = document.querySelector("[data-hero-content]");
  const cards = Array.from(document.querySelectorAll("[data-project-card]"));

  const normalize = (value: string) =>
    value
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .trim();

  const updateProjects = () => {
    if (!(searchInput instanceof HTMLInputElement)) return;

    const query = normalize(searchInput.value);
    let visibleCount = 0;

    cards.forEach((card) => {
      const searchableText = normalize(card.getAttribute("data-search-index") || "");
      const matches = !query || searchableText.includes(query);
      card.toggleAttribute("hidden", !matches);
      if (matches) visibleCount += 1;
    });

    if (countElement) {
      countElement.textContent = `${visibleCount} ${visibleCount === 1 ? "proyecto" : "proyectos"}`;
    }

    if (emptyState) {
      emptyState.toggleAttribute("hidden", visibleCount > 0);
    }

    if (clearButton) {
      clearButton.toggleAttribute("hidden", query.length === 0);
    }
  };

  searchInput?.addEventListener("input", updateProjects);
  clearButton?.addEventListener("click", () => {
    if (!(searchInput instanceof HTMLInputElement)) return;
    searchInput.value = "";
    searchInput.focus();
    updateProjects();
  });

  const updateHeroScroll = () => {
    if (!(heroContent instanceof HTMLElement)) return;

    const progress = Math.min(window.scrollY / 420, 1);
    heroContent.style.setProperty("--hero-parallax", `${Math.round(window.scrollY * -0.12)}px`);
    nav?.toggleAttribute("data-scrolled", progress > 0.28);
  };

  updateHeroScroll();
  window.addEventListener("scroll", updateHeroScroll, { passive: true });
</script>
